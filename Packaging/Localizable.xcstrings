{
  "sourceLanguage": "en",
  "strings": {
    "%@ (%@) asked to pair.": {
      "comment": "The device name is supplied by the device and must remain unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@) asked to pair."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%@）请求配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%@）要求配對。"
          }
        }
      }
    },
    "%@ Connected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Connected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已连接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已連線"
          }
        }
      }
    },
    "%@ Wants to Pair": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Wants to Pair"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 请求配对"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 要求配對"
          }
        }
      }
    },
    "%@ asked to pair.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ asked to pair."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 请求配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 要求配對。"
          }
        }
      }
    },
    "%@ can no longer connect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can no longer connect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已无法连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已無法連線。"
          }
        }
      }
    },
    "%@ can no longer connect. To use it again, pair it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can no longer connect. To use it again, pair it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已无法连接。如需再次使用，请重新配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已無法連線。如需再次使用，請重新配對。"
          }
        }
      }
    },
    "%@ is paired with this Mac.": {
      "comment": "The argument is a device name; do not translate the name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is paired with this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已与这台 Mac 配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已與這部 Mac 配對。"
          }
        }
      }
    },
    "%@ is still paired: Sill couldn’t update the keychain (%@). Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is still paired: Sill couldn’t update the keychain (%@). Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仍处于配对状态：Sill 未能更新钥匙串（%@）。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仍處於配對狀態：Sill 無法更新鑰匙圈（%@）。請再試一次。"
          }
        }
      }
    },
    "%@ nearby asked to pair.": {
      "comment": "The device name is supplied by the device and must remain unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nearby asked to pair."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附近的 %@ 请求配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附近的 %@ 要求配對。"
          }
        }
      }
    },
    "%@ on this Mac asked to pair.": {
      "comment": "The device name is supplied by the device and must remain unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on this Mac asked to pair."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上的 %@ 请求配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 Mac 上的 %@ 要求配對。"
          }
        }
      }
    },
    "%@ on this network asked to pair.": {
      "comment": "The device name is supplied by the device and must remain unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on this network asked to pair."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此网络上的 %@ 请求配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此網路上的 %@ 要求配對。"
          }
        }
      }
    },
    "%@ — Not connected": {},
    "%@. Quit and reopen Sill to try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Quit and reopen Sill to try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。请退出并重新打开 Sill 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。請結束並重新開啟 Sill 後再試一次。"
          }
        }
      }
    },
    "%lld": {},
    "%lld Devices Connected": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Device Connected"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Devices Connected"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接 %lld 台设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連線 %lld 部裝置"
          }
        }
      }
    },
    "120 fps": {},
    "60 fps": {},
    "A code is showing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A code is showing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对码已显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對碼已顯示。"
          }
        }
      }
    },
    "A device": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一台设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一部裝置"
          }
        }
      }
    },
    "A paired TLS identity is required.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A paired TLS identity is required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要配对的 TLS 身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要配對的 TLS 身分。"
          }
        }
      }
    },
    "A paired device can see and control this Mac on your network, nearby, and from afar while Remote Access is on. If one is lost, remove it here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A paired device can see and control this Mac on your network, nearby, and from afar while Remote Access is on. If one is lost, remove it here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对后的设备可在此网络上或附近查看和控制这台 Mac，开启远程访问后也可从外部连接。设备丢失时，请在这里移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對後的裝置可在此網路上或附近查看及控制這部 Mac，開啟遠端存取後也可從外部連線。裝置遺失時，請在這裡移除。"
          }
        }
      }
    },
    "A paired device can see and control this Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A paired device can see and control this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对后的设备可以查看和控制这台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對後的裝置可以查看及控制這部 Mac。"
          }
        }
      }
    },
    "A paired device supplied incomplete APNs registration settings. Live inbox delivery remains available.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A paired device supplied incomplete APNs registration settings. Live inbox delivery remains available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配对设备提供的 APNs 注册设置不完整。实时收件箱仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已配對裝置提供的 APNs 註冊設定不完整。即時收件匣仍可使用。"
          }
        }
      }
    },
    "A paired device's APNs topic or environment does not match this Mac's provider settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A paired device's APNs topic or environment does not match this Mac's provider settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配对设备的 APNs 主题或环境与此 Mac 的推送服务设置不匹配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已配對裝置的 APNs 主題或環境與此 Mac 的推播服務設定不符。"
          }
        }
      }
    },
    "A wrong code came from %@. %lld tries left.": {
      "comment": "Pairing failure: first argument is the device address; second is the number of attempts left.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A wrong code came from %1$@. %#@tries@ left."
          },
          "substitutions": {
            "tries": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg try"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg tries"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 输入的配对码有误。还可尝试 %lld 次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 輸入的配對碼有誤。還可嘗試 %lld 次。"
          }
        }
      }
    },
    "APNs Key ID": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs Key ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs 密钥 ID"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs 金鑰 ID"
          }
        }
      }
    },
    "APNs Key ID must be 10 letters or digits.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs Key ID must be 10 letters or digits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs 密钥 ID 必须为 10 个字母或数字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs 金鑰 ID 必須為 10 個字母或數字。"
          }
        }
      }
    },
    "APNs Team ID must be 10 letters or digits.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs Team ID must be 10 letters or digits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs 团队 ID 必须为 10 个字母或数字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs 團隊 ID 必須為 10 個字母或數字。"
          }
        }
      }
    },
    "APNs configured; awaiting a paired device registration and a notification. Delivery is not verified yet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs configured; awaiting a paired device registration and a notification. Delivery is not verified yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs 已配置；正在等待已配对设备注册及通知。传送尚未验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs 已設定；正在等待已配對裝置註冊及通知。傳送尚未驗證。"
          }
        }
      }
    },
    "APNs configured; pending notifications will be retried. Apple acceptance does not confirm device display.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs configured; pending notifications will be retried. Apple acceptance does not confirm device display."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs 已配置；待发送通知将重试。Apple 接受请求并不表示设备已显示通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs 已設定；待傳送通知將重試。Apple 接受請求並不表示裝置已顯示通知。"
          }
        }
      }
    },
    "APNs delivery failed temporarily. The notification is saved and will be retried.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs delivery failed temporarily. The notification is saved and will be retried."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs 暂时发送失败。通知已保存，将自动重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs 暫時傳送失敗。通知已儲存，將自動重試。"
          }
        }
      }
    },
    "APNs environment": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs environment"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs 环境"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs 環境"
          }
        }
      }
    },
    "APNs retries are paused after repeated failures. The notification remains saved; renew the registration or provider settings to retry. Reconnecting Sill can recover its inbox history.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs retries are paused after repeated failures. The notification remains saved; renew the registration or provider settings to retry. Reconnecting Sill can recover its inbox history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs 多次发送失败，重试已暂停。通知仍已保存；请更新注册信息或推送服务设置以重试。重新连接 Sill 可恢复收件箱历史。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs 多次傳送失敗，重試已暫停。通知仍已儲存；請更新註冊資訊或推送服務設定以重試。重新連線 Sill 可還原收件匣記錄。"
          }
        }
      }
    },
    "APNs topic must be an app bundle identifier.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs topic must be an app bundle identifier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs 主题必须是 App 的 bundle identifier。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs 主題必須是 App 的 bundle identifier。"
          }
        }
      }
    },
    "About Sill": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About Sill"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于 Sill"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關於 Sill"
          }
        }
      }
    },
    "Access belongs to Sill itself. Access you gave Terminal for the SillHost command-line tool doesn’t carry over.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access belongs to Sill itself. Access you gave Terminal for the SillHost command-line tool doesn’t carry over."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些权限授予 Sill 本身。为 SillHost 命令行工具授予“终端”的权限不会沿用到这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些權限授予 Sill 本身。為 SillHost 命令列工具授予「終端機」的權限不會沿用到這裡。"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用"
          }
        }
      }
    },
    "Accessibility Settings…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility Settings…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能设置…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用設定…"
          }
        }
      }
    },
    "Accessibility permission is required to observe exposed notification text.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission is required to observe exposed notification text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要辅助功能权限才能读取公开的通知文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要輔助使用權限才能讀取公開的通知文字。"
          }
        }
      }
    },
    "Accessibility: Allowed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility: Allowed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能：已允许"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用：已允許"
          }
        }
      }
    },
    "Accessibility: Not Allowed…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility: Not Allowed…"
