    "Unlock this Mac, then tap it on the %@ again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock this Mac, then tap it on the %@ again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请解锁这台 Mac，然后在 %@ 上再次轻点它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請解鎖這部 Mac，然後在 %@ 上再點一下這部 Mac。"
          }
        }
      }
    },
    "Up to %lld fps": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to %lld fps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最高 %lld fps"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最高 %lld fps"
          }
        }
      }
    },
    "Uses a private macOS interface (CGVirtualDisplay). If a macOS update breaks it, Sill streams the window where it is.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 macOS 的私有介面（CGVirtualDisplay）。如果 macOS 更新後無法使用，Sill 會改在視窗原位置串流。"
          }
        }
      }
    },
    "Virtual Display": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtual Display"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "虚拟显示器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "虛擬顯示器"
          }
        }
      }
    },
    "Visible on your network as": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在網路上顯示為"
          }
        }
      }
    },
    "Waiting for a Device": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for a Device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等候裝置"
          }
        }
      }
    },
    "Waiting for the Network": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the Network"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
