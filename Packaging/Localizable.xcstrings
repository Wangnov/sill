          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部裝置嘗試用舊版 Sill 連線。"
          }
        }
      }
    },
    "Last checked %@.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次檢查：%@。"
          }
        }
      }
    },
    "Last window": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近的視窗"
          }
        }
      }
    },
    "Launch at Login": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at Login"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时启动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入時啟動"
          }
        }
      }
    },
    "Launch at login": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入時啟動"
          }
        }
      }
    },
    "Lets Sill capture the windows you pick on your iPhone or iPad, and their sound when Send Audio is on. Nothing is recorded or saved; frames and sound go straight to your devices.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets Sill capture the windows you pick on your iPhone or iPad, and their sound when Send Audio is on. Nothing is recorded or saved; frames and sound go straight to your devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Sill 捕捉你在 iPhone 或 iPad 上选择的窗口，以及开启“发送音频”时的声音。内容不会被录制或保存，画面和声音会直接传送到你的设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 Sill 擷取你在 iPhone 或 iPad 上選的視窗，開啟「傳送音訊」時也擷取它們的聲音。Sill 不會錄製或儲存任何內容，畫面和聲音直接傳到你的裝置。"
          }
        }
      }
    },
    "Lets the iPhone and iPad you pair connect to this Mac from other networks: through a VPN such as Tailscale, or through a port you forward on your router. Sill turns away every device you haven’t paired, and encrypts everything the paired ones send and receive.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓已配對的 iPhone 和 iPad 從其他網路連線到這部 Mac：透過 Tailscale 等 VPN，或透過你在路由器上轉送的連接埠。Sill 會拒絕所有未配對的裝置，並加密已配對裝置收發的所有資料。"
          }
        }
      }
    },
    "Lets your iPhone and iPad connect when they’re near this Mac, even without a shared Wi‑Fi network, the way AirDrop does. While it’s on, this Mac’s Wi‑Fi keeps stepping away from your network, so streaming over Wi‑Fi can stutter. Anyone nearby with Sill can find this Mac; only devices you paired can connect, unless Require pairing is off.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 iPhone 和 iPad 靠近這部 Mac 時，即使沒有共用的 Wi‑Fi 網路，也能像 AirDrop 一樣連線。開啟期間，這部 Mac 的 Wi‑Fi 會不時離開目前的網路，所以透過 Wi‑Fi 串流可能會停頓。附近任何有 Sill 的人都能找到這部 Mac；除非關閉「要求配對」，否則只有已配對的裝置能連線。"
          }
        }
      }
    },
    "Lets your iPhone or iPad click, scroll and type on this Mac, and lets Sill move and size the window it streams.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets your iPhone or iPad click, scroll and type on this Mac, and lets Sill move and size the window it streams."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 iPhone 或 iPad 在这台 Mac 上点按、滚动和输入，并允许 Sill 移动串流窗口及调整其大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 iPhone 或 iPad 在這部 Mac 上點按、捲動和輸入，也讓 Sill 能移動串流中的視窗並調整大小。"
          }
        }
      }
    },
