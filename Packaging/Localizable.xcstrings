                  "state": "translated",
                  "value": "Streaming to %lld Device"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Streaming to %lld Devices"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在串流至 %lld 台设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在串流至 %lld 部裝置"
          }
        }
      }
    },
    "Streaming to a Device": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming to a Device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在串流至一台设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在串流至一部裝置"
          }
        }
      }
    },
    "Streaming with the software encoder, up to 60 fps, until it is free again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming with the software encoder, up to 60 fps, until it is free again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "硬件编码器恢复空闲前，使用软件编码器串流，最高 60 fps。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在硬體編碼器空出來之前，先用軟體編碼器串流，最高 60 fps。"
          }
        }
      }
    },
    "Streaming with the software encoder, up to 60 fps. Restarting the Mac fixes this.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming with the software encoder, up to 60 fps. Restarting the Mac fixes this."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在使用软件编码器串流，最高 60 fps。重新启动 Mac 可解决此问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在使用軟體編碼器串流，最高 60 fps。重新啟動 Mac 可解決此問題。"
          }
        }
      }
    },
    "Test Pattern": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "測試圖樣"
          }
        }
      }
    },
    "Test Pattern Mode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test Pattern Mode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试图案模式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "測試圖樣模式"
          }
        }
      }
    },
    "Text you copy here can be pasted on a connected iPhone or iPad, and text sent from one with Paste becomes this Mac’s. Copies a password manager marks as concealed stay on this Mac.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這裡拷貝的文字可以貼到已連線的 iPhone 或 iPad，裝置用「貼上」傳來的文字會放進這部 Mac 的剪貼板。密碼管理工具標示為隱藏的拷貝內容會留在這部 Mac 上。"
          }
        }
      }
    },
    "That doesn’t look like an address. Try home.example.net, or home.example.net:17455.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這看起來不像位址。請試試 home.example.net 或 home.example.net:17455。"
          }
        }
      }
    },
    "The Mac keeps playing it too": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac keeps playing it too"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 也会继续播放声音"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 也會繼續播放聲音"
          }
        }
      }
    },
    "The devices you pair in Devices can connect from afar while Remote Access is on.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟遠端存取時，在「裝置」中配對的裝置在外也能連線。"
          }
        }
      }
    },
    "The hardware encoder is busy or not answering, so streams use the software encoder: up to 60 fps at Standard resolution. Sill switches back by itself once it keeps up again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "硬體編碼器忙碌或沒有回應，串流改用軟體編碼器：最高 60 fps、標準解析度。硬體編碼器跟得上時，Sill 會自動切換回去。"
          }
        }
      }
    },
    "The hardware encoder is stuck, so streams use the software encoder: up to 60 fps at Standard resolution. Restarting the Mac fixes this.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "硬體編碼器卡住了，串流改用軟體編碼器：最高 60 fps、標準解析度。重新啟動 Mac 即可解決。"
          }
        }
      }
    },
    "The link can’t carry %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線無法負荷「%@」畫質"
          }
        }
      }
    },
    "The login item and the permissions follow this copy of Sill. Keep one copy, in Applications.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入項目和權限會跟著這一份 Sill。請只保留一份，放在「應用程式」檔案夾中。"
          }
        }
      }
    },
    "The streamed window is on the virtual display": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "串流中的視窗在虛擬顯示器上"
          }
        }
      }
    },
    "This Mac can’t be reached while it’s asleep. While a device is connected from away, Sill keeps it from going to sleep by itself.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 Mac 睡眠時無法連線。有裝置在外連線期間，Sill 會防止 Mac 自行進入睡眠。"
          }
        }
      }
    },
    "This build of Sill has no version number, so it can’t check.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 Sill 版本沒有版本編號，無法檢查。"
          }
        }
      }
    },
    "This code expired.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code expired."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此配对码已过期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此配對碼已過期。"
          }
        }
      }
    },
    "This code no longer works.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code no longer works."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此配对码已失效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此配對碼已失效。"
          }
        }
      }
    },
    "This is the Mac’s name.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是這部 Mac 的名稱。"
          }
        }
      }
    },
    "This network. Use it with a VPN into your home network, such as WireGuard on your router.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前所在的網路。可搭配連回家中網路的 VPN 使用，例如路由器上的 WireGuard。"
          }
        }
      }
    },
    "Try Again": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再試一次"
          }
        }
      }
    },
    "Turn On Remote Access": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn On Remote Access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启远程访问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟遠端存取"
          }
        }
      }
    },
    "Turn this on to pair while you use this Mac through Screen Sharing or another remote desktop app, as you would a Mac without a display. While it’s on, anyone who can see this Mac’s screen remotely can read the code. Devices streaming this Mac never show the window.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn this on to pair while you use this Mac through Screen Sharing or another remote desktop app, as you would a Mac without a display. While it’s on, anyone who can see this Mac’s screen remotely can read the code. Devices streaming this Mac never show the window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过“屏幕共享”或其他远程桌面应用使用这台 Mac 时，可开启此选项进行配对，例如为没有显示器的 Mac 配对。开启后，任何能够远程查看此 Mac 屏幕的人都能读到配对码。串流此 Mac 的设备始终不会显示此窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你透過「螢幕共享」或其他遠端桌面 App 使用這部 Mac（例如沒有接螢幕的 Mac），開啟這個選項才能配對。開啟期間，任何能從遠端看到這部 Mac 螢幕的人都看得到配對碼。正在串流這部 Mac 的裝置一律看不到這個視窗。"
          }
        }
      }
    },
    "Ultra": {
      "comment": "Quality preset",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultra"
          }
        }
      }
    },
