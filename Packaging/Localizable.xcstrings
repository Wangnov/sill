            "state": "translated",
            "value": "home.example.net"
          }
        }
      }
    },
    "just now": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "just now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
