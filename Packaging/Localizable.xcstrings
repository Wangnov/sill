          "stringUnit": {
            "state": "translated",
            "value": "正在串流至 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在串流至 %@"
          }
        }
      }
    },
    "Streaming to %lld Devices": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
