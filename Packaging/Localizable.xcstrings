          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等候網路"
          }
        }
      }
    },
    "Waiting for your approval": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等候你的核准"
          }
        }
      }
    },
    "Whole Desktop": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整個桌面"
          }
        }
      }
    },
    "Window": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗"
          }
        }
      }
    },
    "Wired": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有線"
          }
        }
      }
    },
    "Works once, for the next %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works once, for the next %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅可使用一次，剩余有效时间 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只能用一次，%@ 內有效。"
          }
        }
      }
    },
    "Works only if your router lets incoming IPv6 connections reach this Mac; most don’t.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在路由器允許外部 IPv6 連線進入這部 Mac 時才有效；大多數路由器都不允許。"
          }
        }
      }
    },
    "You have %@; opens its download page": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前版本 %@；會打開下載頁面"
          }
        }
      }
    },
    "Your devices can’t reach this Mac through %@ until it connects.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 連線之前，裝置無法透過它連到這部 Mac。"
          }
        }
      }
    },
    "Your devices learn these when they pair and keep them current whenever they connect.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置會在配對時取得這些位址，並在每次連線時更新。"
          }
        }
      }
    },
    "Your internet provider shares this address among many homes (%@), so a port forward can’t reach this Mac. Use a VPN such as Tailscale instead.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的網路業者讓許多家庭共用這個位址（%@），所以連接埠轉送無法連到這部 Mac。請改用 Tailscale 等 VPN。"
          }
        }
      }
    },
    "Your paired devices show here once Sill can use its key again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your paired devices show here once Sill can use its key again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill 能够再次使用密钥后，已配对设备将显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等 Sill 能再次使用金鑰，已配對的裝置就會顯示在這裡。"
          }
        }
      }
    },
    "Your router didn’t say. You’ll find the address in its settings.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "路由器沒有回報。你可以在路由器設定中找到這個位址。"
          }
        }
      }
    },
    "Your router sits behind another router. Forward the port on both, or use a VPN.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的路由器位在另一台路由器後方。請在兩台路由器上都設定連接埠轉送，或改用 VPN。"
          }
        }
      }
    },
    "You’re all set. Open Sill on your iPhone or iPad.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re all set. Open Sill on your iPhone or iPad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已准备就绪。请在 iPhone 或 iPad 上打开 Sill。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已準備就緒。請在 iPhone 或 iPad 上打開 Sill。"
          }
        }
      }
    },
    "by address": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以位址連線"
          }
        }
      }
    },
