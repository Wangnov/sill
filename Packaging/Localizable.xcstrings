    "last connected %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "last connected %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次连接：%@"
